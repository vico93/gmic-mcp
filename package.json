{
  "name": "gmic-mcp",
  "version": "0.2.0",
  "description": "A local Model Context Protocol server for the G'MIC image-processing CLI",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmic",
    "image-processing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vico93/gmic-mcp.git"
  },
  "homepage": "https://github.com/vico93/gmic-mcp#readme",
  "bugs": "https://github.com/vico93/gmic-mcp/issues",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "gmic-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
